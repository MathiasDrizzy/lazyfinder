{
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "name": "sidebar-actions",
  "criterio": "order 07 point M5: the tree has new file, new folder, refresh and collapse icons that work with the mouse",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "--sidebar",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 40,
  "rows": 24,
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the tree starts collapsed (point M3)",
      "wait": {
        "regex": "\\bv\\s",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "the buttons of the tree appear while the pointer moves over the pane",
      "text": "\u001b[<35;10;6M"
    },
    {
      "wait": {
        "regex": "",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the second icon of the header asks for a folder name",
      "click": {
        "x": 35,
        "y": 3
      }
    },
    {
      "wait": {
        "regex": "New folder: untitled folder",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "esc"
      ]
    },
    {
      "desc": "a key press hid the buttons; the pointer brings them back",
      "text": "\u001b[<35;11;6M"
    },
    {
      "desc": "the first icon asks for a file name",
      "click": {
        "x": 32,
        "y": 3
      }
    },
    {
      "wait": {
        "regex": "New file: untitled file",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "esc"
      ]
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
