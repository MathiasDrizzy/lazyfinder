{
  "name": "lazyfinder-sidebar-icons",
  "criterio": "order 2026-10-13-06 point 1, Mathias's precision (Finder): every Favorites and Locations entry has its own Nerd Font glyph and the accent color, not the generic grey folder",
  "cmd": [
    "sh",
    "-c",
    "mkdir -p \"${TUIQA_HOME}/.config/lazyfinder\" \"${TUIQA_HOME}/Desktop\" \"${TUIQA_HOME}/Documents\" \"${TUIQA_HOME}/Downloads\" \"${TUIQA_HOME}/Music\" \"${TUIQA_HOME}/.Trash\" && printf '%s' '{\"version\":1,\"sidebar\":{\"favorites\":[{\"name\":\"Home\",\"path\":\"~\"},{\"name\":\"Desktop\",\"path\":\"~/Desktop\"},{\"name\":\"Documents\",\"path\":\"~/Documents\"},{\"name\":\"Downloads\",\"path\":\"~/Downloads\"},{\"name\":\"Applications\",\"path\":\"/Applications\"},{\"name\":\"Music\",\"path\":\"~/Music\"}],\"locations\":[{\"name\":\"Macintosh HD\",\"path\":\"/\"},{\"name\":\"Volumes\",\"path\":\"/Volumes\"},{\"name\":\"Trash\",\"path\":\"~/.Trash\"}]}}' > \"${TUIQA_HOME}/.config/lazyfinder/config.json\" && exec \"${LAZYFINDER_BIN}\" \"${TUIQA_HOME}/proj\""
  ],
  "cols": 120,
  "rows": 30,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "Recents has the clock",
      "wait": {
        "regex": "\\s+Recents",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Home has its own glyph U+F015",
      "wait": {
        "regex": "\\s+Home",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Desktop has its own glyph U+F108",
      "wait": {
        "regex": "\\s+Desktop",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Documents has its own glyph U+F0F6",
      "wait": {
        "regex": "\\s+Documents",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Downloads has its own glyph U+F019",
      "wait": {
        "regex": "\\s+Downloads",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Applications has its own glyph U+F135",
      "wait": {
        "regex": "\\s+Applications",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Music has its own glyph U+F001",
      "wait": {
        "regex": "\\s+Music",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Macintosh HD has its own glyph U+F0A0",
      "wait": {
        "regex": "\\s+Macintosh HD",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Volumes has its own glyph U+F0A0",
      "wait": {
        "regex": "\\s+Volumes",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Trash has its own glyph U+F1F8",
      "wait": {
        "regex": "\\s+Trash",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "no entry is left with the generic folder glyph",
      "wait": {
        "regex": "\\s+(Home|Desktop|Documents|Downloads|Applications|Music|Macintosh HD|Volumes|Trash|Recents)",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "the glyphs take the accent color of the theme",
      "assert_color": {
        "region": {
          "line_with": "Downloads",
          "x": 3,
          "y": 0,
          "w": 1,
          "h": 1
        },
        "fg": "#89b4fa",
        "mode": "any"
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
