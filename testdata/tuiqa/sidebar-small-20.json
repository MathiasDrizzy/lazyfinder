{
  "name": "sidebar-small-20",
  "criterio": "order 07 point M6: at 20x10 the sidebar mode is not cut and Settings scrolls with a counter",
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "--sidebar",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 20,
  "rows": 10,
  "steps": [
    {
      "wait": {
        "regex": "PROJ",
        "timeout_ms": 8000
      }
    },
    {
      "wait": {
        "regex": "too small",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "the tab bar is whole: the chip of the active tab reaches the row under the icons",
      "wait": {
        "regex": "▀▀▀▀",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        ","
      ]
    },
    {
      "desc": "Settings fits the window and says where it is",
      "wait": {
        "regex": "1/25",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "end"
      ]
    },
    {
      "desc": "scrolling to the end shows the last row and its position",
      "wait": {
        "regex": "25/25",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "esc",
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
