{
  "name": "lazyfinder-rebound-keys",
  "criterio": "R-44 (keys from config.json replace the defaults; the key bar shows them)",
  "cmd": ["${LAZYFINDER_BIN}", "${TUIQA_HOME}/proj"],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "env": {"LAZYFINDER_CONFIG": "${TUIQA_SCENARIO_DIR}/fixtures-keys/config.json"},
  "steps": [
    {"wait": {"regex": "notes\\.txt", "timeout_ms": 8000}},
    {"assert": {"contains": "Quit: Z"}},
    {"desc": "w is down now", "keys": ["w"]},
    {"wait": {"regex": "2 of 6"}},
    {"desc": "j is not bound any more", "keys": ["j"]},
    {"assert": {"contains": "2 of 6"}},
    {"desc": "q does not quit", "keys": ["q"]},
    {"assert": {"contains": "2 of 6"}},
    {"desc": "Z quits", "keys": ["Z"]},
    {"wait_exit": {"timeout_ms": 3000, "code": 0}}
  ]
}
