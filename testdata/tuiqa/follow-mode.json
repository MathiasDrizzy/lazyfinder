{
  "name": "lazyfinder-follow-mode",
  "criterio": "R-32",
  "cmd": [
    "sh",
    "-c",
    "(sleep 2; mkdir \"${TUIQA_HOME}/proj/agent-made\" && echo 'fn main() {}' > \"${TUIQA_HOME}/proj/agent-made/main.rs\") & exec \"${LAZYFINDER_BIN}\" --follow \"${TUIQA_HOME}/proj\""
  ],
  "cols": 40,
  "rows": 20,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "desc": "the project shows as a narrow tree, collapsed",
      "wait": {
        "regex": "alpha",
        "timeout_ms": 8000
      }
    },
    {
      "wait": {
        "regex": "inner\\.txt",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "no sidebar and no columns",
      "wait": {
        "regex": "Favorites",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "wait": {
        "regex": "Date Modified",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "wait": {
        "regex": "agent-made",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "a folder created by another process appears open, with its file",
      "wait": {
        "regex": "main\\.rs",
        "timeout_ms": 8000
      }
    },
    {
      "wait": {
        "regex": "agent-made\\s+\\+",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "everything that is new is marked with +",
      "wait": {
        "regex": "\\+\\s+\\S\\s+main\\.rs",
        "timeout_ms": 5000
      }
    },
    {
      "snapshot": {
        "name": "follow-mode"
      }
    },
    {
      "desc": "the keys keep working in the narrow view",
      "keys": [
        "up",
        "up",
        "up",
        "up"
      ]
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
