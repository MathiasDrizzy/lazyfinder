{
  "name": "lazyfinder-user-theme",
  "criterio": "R-41 (a user theme from <config dir>/themes)",
  "cmd": ["${LAZYFINDER_BIN}", "${TUIQA_HOME}/proj"],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "env": {"LAZYFINDER_CONFIG": "${TUIQA_SCENARIO_DIR}/fixtures-themes/config.json"},
  "steps": [
    {"wait": {"regex": "notes\\.txt", "timeout_ms": 8000}},
    {"desc": "the selection bar uses the user theme's peach", "assert_color": {"region": {"line_with": "▸ >\\s+alpha"}, "bg": "#99c1dc", "mode": "any"}},
    {"assert_color": {"region": {"line_with": "beta"}, "bg": "#0a1014", "mode": "any"}},
    {"keys": ["q"]},
    {"wait_exit": {"timeout_ms": 3000, "code": 0}}
  ]
}
