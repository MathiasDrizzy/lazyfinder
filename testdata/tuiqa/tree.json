{
  "name": "lazyfinder-tree",
  "criterio": "R-33",
  "cmd": [
    "sh",
    "-c",
    "printf '{\"version\":1,\"density\":\"compact\"}' > \"${TUIQA_HOME}/density.json\"; exec \"${LAZYFINDER_BIN}\" \"${TUIQA_HOME}/proj\""
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "desc": "starts",
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "wait": {
        "regex": "inner\\.txt",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "a click on the > marker opens the folder in place",
      "click": {
        "x": 25,
        "y": 3
      }
    },
    {
      "wait": {
        "regex": "inner\\.txt",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "the marker turns into v and the children are indented",
      "wait": {
        "regex": "v\\s+\\S\\s+alpha",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "\\s{4}\\S\\s+inner\\.txt",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "folders open inside folders with +",
      "keys": [
        "down",
        "+"
      ]
    },
    {
      "wait": {
        "regex": "x\\.txt",
        "timeout_ms": 3000
      }
    },
    {
      "wait": {
        "regex": "\\s{6}\\S\\s+x\\.txt",
        "timeout_ms": 5000
      }
    },
    {
      "snapshot": {
        "name": "tree"
      }
    },
    {
      "desc": "- closes the folder again",
      "keys": [
        "-"
      ]
    },
    {
      "wait": {
        "regex": "x\\.txt",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "a - on a child closes its parent and selects it",
      "keys": [
        "down",
        "-"
      ]
    },
    {
      "wait": {
        "regex": "inner\\.txt",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "wait": {
        "regex": "▸ >\\s+\\S\\s+alpha",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ],
  "env": {
    "LAZYFINDER_CONFIG": "${TUIQA_HOME}/density.json"
  }
}
