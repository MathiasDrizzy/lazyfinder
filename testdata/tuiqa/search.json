{
  "name": "lazyfinder-search",
  "criterio": "R-34 R-50",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "desc": "starts",
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the toolbar has a clickable search glyph",
      "click": {
        "at": "",
        "in": {
          "x": 0,
          "y": 0,
          "w": 120,
          "h": 1
        }
      }
    },
    {
      "desc": "the bar opens at the bottom",
      "wait": {
        "regex": "type to search",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "typing filters the folder live",
      "text": "notes"
    },
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "wait": {
        "regex": "1 found",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Tab searches the subfolders too",
      "keys": [
        "ctrl+u"
      ]
    },
    {
      "text": "txt"
    },
    {
      "keys": [
        "tab"
      ]
    },
    {
      "wait": {
        "regex": "x\\.txt\\s+‹ alpha/",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "each result says where it lives",
      "wait": {
        "regex": "inner\\.txt\\s+‹ alpha",
        "timeout_ms": 5000
      }
    },
    {
      "snapshot": {
        "name": "search-recursive"
      }
    },
    {
      "desc": "a chip is a click away",
      "keys": [
        "ctrl+u"
      ]
    },
    {
      "click": {
        "at": "Folders",
        "in": {
          "x": 0,
          "y": 38,
          "w": 120,
          "h": 1
        }
      }
    },
    {
      "wait": {
        "regex": "kind:folder",
        "timeout_ms": 3000
      }
    },
    {
      "wait": {
        "regex": ">\\s+\\S\\s+alpha",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "Esc clears the search and the folder comes back",
      "keys": [
        "esc"
      ]
    },
    {
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 3000
      }
    },
    {
      "wait": {
        "regex": "Search: /",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
