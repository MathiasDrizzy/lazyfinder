{
  "name": "lazyfinder-workspace",
  "criterio": "R-53 (tabs, quick filter, column layout, bookmarks, tags)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "ctrl+t opens a second tab",
      "keys": [
        "ctrl+t"
      ]
    },
    {
      "wait": {
        "regex": "Tab 2/2",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "{ goes back to the first one",
      "keys": [
        "{"
      ]
    },
    {
      "wait": {
        "regex": "Tab 1/2",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "f filters the folder by name while typing",
      "keys": [
        "f",
        "n",
        "o",
        "t",
        "e",
        "s"
      ]
    },
    {
      "wait": {
        "regex": "filter: notes",
        "timeout_ms": 3000
      }
    },
    {
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "keys": [
        "enter",
        "esc"
      ]
    },
    {
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "M switches to the column layout: parent, folder, preview",
      "keys": [
        "M"
      ]
    },
    {
      "wait": {
        "regex": "Parent",
        "timeout_ms": 3000
      }
    },
    {
      "wait": {
        "regex": "Date Modified",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "snapshot": {
        "name": "columns"
      }
    },
    {
      "desc": "the right column shows the start of the selected file",
      "wait": {
        "regex": "first line",
        "timeout_ms": 3000
      }
    },
    {
      "keys": [
        "M"
      ]
    },
    {
      "wait": {
        "regex": "Date Modified",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "b bookmarks the selected folder in the sidebar",
      "keys": [
        "g",
        "b"
      ]
    },
    {
      "wait": {
        "regex": "Bookmarked",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "t tags a file, tag: finds it",
      "keys": [
        "G",
        "t",
        "w",
        "o",
        "r",
        "k",
        "enter"
      ]
    },
    {
      "wait": {
        "regex": "Tagged: work",
        "timeout_ms": 3000
      }
    },
    {
      "keys": [
        "/",
        "t",
        "a",
        "g",
        ":",
        "w",
        "o",
        "r",
        "k"
      ]
    },
    {
      "wait": {
        "regex": "1 found",
        "timeout_ms": 3000
      }
    },
    {
      "keys": [
        "esc",
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
