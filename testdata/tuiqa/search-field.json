{
  "name": "lazyfinder-search-field",
  "criterio": "order 2026-10-13-05 block C (visible Search field top right; scope, what and by choices; Recents place)",
  "cmd": ["${LAZYFINDER_BIN}", "${TUIQA_HOME}/proj"],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {"wait": {"regex": "notes\\.txt", "timeout_ms": 8000}},
    {"desc": "the top row has a Search field", "assert": {"contains": "⌕ Search"}},
    {"desc": "Recents is a place of the sidebar", "assert": {"contains": "Recents"}},
    {"desc": "a click on the field starts a search", "click": {"at": "Search", "in": {"x": 0, "y": 0, "w": 120, "h": 1}}},
    {"keys": ["n", "o", "t", "e", "s"]},
    {"desc": "the bar offers the three choices", "assert": {"contains": "\\[This folder\\]\\s+\\[Files and folders\\]\\s+\\[Name\\]"}},
    {"desc": "only the match is left", "assert": {"not_contains": "data\\.xlsx"}},
    {"desc": "clear the query first: the system index is never asked from a test", "keys": ["ctrl+u", "tab", "tab"]},
    {"desc": "two Tabs reach the whole system", "assert": {"contains": "\\[System\\]"}},
    {"keys": ["tab", "ctrl+k"]},
    {"desc": "kinds moved on to files", "assert": {"contains": "\\[Files\\]"}},
    {"keys": ["esc"]},
    {"desc": "closing brings the folder back", "assert": {"contains": "data\\.xlsx"}}
  ]
}
