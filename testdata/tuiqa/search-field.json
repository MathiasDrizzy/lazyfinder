{
  "name": "lazyfinder-search-field",
  "criterio": "order 2026-10-13-05 block C (visible Search field top right; scope, what and by choices; Recents place)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the top row has a Search field",
      "wait": {
        "regex": " Search",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Recents is a place of the sidebar",
      "wait": {
        "regex": "Recents",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "a click on the field starts a search",
      "click": {
        "at": "Search",
        "in": {
          "x": 0,
          "y": 0,
          "w": 120,
          "h": 1
        }
      }
    },
    {
      "keys": [
        "n",
        "o",
        "t",
        "e",
        "s"
      ]
    },
    {
      "desc": "the bar offers the three choices",
      "wait": {
        "regex": "Look in \\(Tab\\):\\s+This folder ▾\\s+What \\(\\^K\\):\\s+Files and folders ▾\\s+By \\(\\^N\\):\\s+Name ▾",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "only the match is left",
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "clear the query first: the system index is never asked from a test",
      "keys": [
        "ctrl+u",
        "tab",
        "tab"
      ]
    },
    {
      "desc": "two Tabs reach the whole system",
      "wait": {
        "regex": "System ▾",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "tab",
        "ctrl+k"
      ]
    },
    {
      "desc": "kinds moved on to files",
      "wait": {
        "regex": "Files ▾",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "esc"
      ]
    },
    {
      "desc": "closing brings the folder back",
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 5000
      }
    }
  ]
}
