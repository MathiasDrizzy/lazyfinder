{
  "name": "lazyfinder-smoke",
  "criterio": "R-05 R-09 R-20",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "desc": "starts and lists the project",
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "column headers",
      "wait": {
        "regex": "Name.*Date Modified.*Size.*Kind",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "sidebar sections",
      "wait": {
        "regex": "Favorites",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Locations",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "folders carry the > marker and sort first",
      "wait": {
        "regex": ">\\s+\\S\\s+alpha",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "kinds come from the built-in table",
      "wait": {
        "regex": "Plain Text",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "PNG image",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "dotfiles are hidden",
      "wait": {
        "regex": "\\.secret",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "the created column shows a real date",
      "wait": {
        "regex": "(Today at \\d\\d:\\d\\d|\\d+ \\w+ 20\\d\\d)",
        "timeout_ms": 5000
      }
    },
    {
      "snapshot": {
        "name": "list"
      }
    },
    {
      "desc": "q quits cleanly",
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
