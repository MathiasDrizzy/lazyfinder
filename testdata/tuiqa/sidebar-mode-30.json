{
  "name": "lazyfinder-sidebar-mode-30",
  "criterio": "order 2026-10-13-07 point G: --sidebar is a first-class mode: tabs Files/Search/Git, the project name in capitals, git letters at the right and the branch at the bottom, at 30 columns",
  "cmd": [
    "sh",
    "-c",
    "cd \"${TUIQA_HOME}/proj\" && export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null && g() { git -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false \"$@\"; } && g init -q -b trunk . && g add . && g commit -q -m init && echo changed >> notes.txt && echo x > loose.txt && exec \"${LAZYFINDER_BIN}\" --sidebar"
  ],
  "cols": 30,
  "rows": 24,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "loose\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the three tabs are on the first row",
      "wait": {
        "regex": "",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the project name is in capitals",
      "wait": {
        "regex": "PROJ",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the branch is at the bottom",
      "wait": {
        "regex": "trunk  ↓0 ↑0",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "a modified file has its letter at the right",
      "wait": {
        "regex": "notes\\.txt\\s+M\\b",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the letter is yellow",
      "assert_color": {
        "region": {
          "line_with": "notes\\.txt",
          "x": 24,
          "w": 4
        },
        "fg": "#f9e2af",
        "mode": "any"
      }
    },
    {
      "desc": "the Git tab keeps only the changed files",
      "click": {
        "at": "",
        "in": {
          "x": 0,
          "y": 1,
          "w": 30,
          "h": 1
        }
      }
    },
    {
      "desc": "the unchanged files are gone",
      "wait": {
        "regex": "data\\.xlsx",
        "absent": true,
        "timeout_ms": 3000
      }
    },
    {
      "wait": {
        "regex": "loose\\.txt",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the Files tab brings everything back",
      "click": {
        "at": "",
        "in": {
          "x": 0,
          "y": 1,
          "w": 30,
          "h": 1
        }
      }
    },
    {
      "wait": {
        "regex": "data\\.xlsx",
        "timeout_ms": 3000
      }
    },
    {
      "desc": "the shortcut to leave the mode is in the bottom bar",
      "wait": {
        "regex": "ctrl\\+b",
        "timeout_ms": 5000
      }
    },
    {
      "snapshot": {
        "name": "sidebar-mode-30"
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
