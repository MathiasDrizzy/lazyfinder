{
  "fixtures": "fixtures",
  "name": "chips-nord",
  "criterio": "order 07 revision 2, S3: the box of a button follows the theme (nord)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "--theme",
    "nord",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 30,
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "text": "\u001b[<35;85;1M"
    },
    {
      "desc": "in nord the box is that theme's surface1",
      "assert_color": {
        "region": {
          "x": 84,
          "y": 0,
          "w": 2,
          "h": 1
        },
        "bg": "#434c5e",
        "mode": "all"
      }
    },
    {
      "desc": "the box starts at the half block before the glyph and ends after its space, so its two margins around the ink are equal in Ghostty (order 07, revision 3)",
      "wait": {
        "regex": "^▐[^ ] ?$",
        "timeout_ms": 3000,
        "region": {
          "x": 83,
          "y": 0,
          "w": 3,
          "h": 1
        }
      }
    },
    {
      "assert_color": {
        "region": {
          "x": 83,
          "y": 0,
          "w": 1,
          "h": 1
        },
        "bg": "#434c5e",
        "mode": "none"
      }
    },
    {
      "assert_color": {
        "region": {
          "x": 86,
          "y": 0,
          "w": 1,
          "h": 1
        },
        "bg": "#434c5e",
        "mode": "none"
      }
    }
  ],
  "fixtures_mtime": "2026-09-01T12:00:00Z"
}
