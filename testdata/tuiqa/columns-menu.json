{
  "name": "lazyfinder-columns-menu",
  "criterio": "order 2026-10-13-06 point 5 (show fewer or more data per file from the header menu and from Settings, with basic and full presets)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 220,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "right click on a header opens the column menu with the presets and the new columns",
      "click": {
        "at": "Kind",
        "in": {
          "x": 23,
          "y": 2,
          "w": 190,
          "h": 1
        },
        "button": "right"
      }
    },
    {
      "wait": {
        "regex": "Owner"
      }
    },
    {
      "wait": {
        "regex": "Basic",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Full",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Path",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Full shows every column",
      "click": {
        "at": "Full",
        "in": {
          "x": 0,
          "y": 0,
          "w": 220,
          "h": 40
        }
      }
    },
    {
      "wait": {
        "regex": "Owner +│",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Permissions",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Date Last Opened",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Settings says so",
      "keys": [
        ","
      ]
    },
    {
      "wait": {
        "regex": "Columns +‹ full ›"
      }
    },
    {
      "keys": [
        "esc"
      ]
    },
    {
      "desc": "Basic goes back to Finder's four",
      "click": {
        "at": "Kind",
        "in": {
          "x": 23,
          "y": 2,
          "w": 190,
          "h": 1
        },
        "button": "right"
      }
    },
    {
      "click": {
        "at": "Basic",
        "in": {
          "x": 0,
          "y": 0,
          "w": 220,
          "h": 40
        }
      }
    },
    {
      "wait": {
        "regex": "Permissions",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "wait": {
        "regex": "Date Created",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "wait": {
        "regex": "Date Modified[^\\n]*│ Size[^\\n]*│ Kind",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
