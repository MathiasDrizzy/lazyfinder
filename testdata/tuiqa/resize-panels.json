{
  "name": "lazyfinder-resize-panels",
  "criterio": "order 2026-10-13-05 block E (drag the sidebar border and a column border, double click fits, keys < >)",
  "cmd": [
    "sh",
    "-c",
    "printf '{\"version\":1,\"density\":\"compact\"}' > \"${TUIQA_HOME}/density.json\"; exec \"${LAZYFINDER_BIN}\" \"${TUIQA_HOME}/proj\""
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the list starts 27 cells from the left",
      "wait": {
        "regex": "(?m)^.{27}Name",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "drag the sidebar border 8 cells right",
      "drag": {
        "from": {
          "x": 21,
          "y": 10
        },
        "to": {
          "x": 29,
          "y": 10
        }
      }
    },
    {
      "desc": "the list now starts at 35",
      "wait": {
        "regex": "(?m)^.{35}Name",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "> widens by two",
      "keys": [
        ">"
      ]
    },
    {
      "wait": {
        "regex": "(?m)^.{37}Name",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "<",
        "<",
        "<"
      ]
    },
    {
      "desc": "< narrows by two",
      "wait": {
        "regex": "(?m)^.{31}Name",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "dragging the border of the Size column does not sort",
      "drag": {
        "from_at": "Size",
        "dx": 10,
        "to": {
          "x": 90,
          "y": 2
        }
      }
    },
    {
      "desc": "still sorted by Name",
      "wait": {
        "regex": "Name ▲",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Size [▲▼]",
        "timeout_ms": 5000,
        "absent": true
      }
    }
  ],
  "env": {
    "LAZYFINDER_CONFIG": "${TUIQA_HOME}/density.json"
  }
}
