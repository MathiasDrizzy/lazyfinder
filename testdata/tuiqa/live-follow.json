{
  "name": "lazyfinder-live-follow",
  "criterio": "R-30",
  "cmd": ["sh", "-c", "(sleep 2; echo 'package agent' > \"${TUIQA_HOME}/proj/agent.go\") & exec \"${LAZYFINDER_BIN}\" \"${TUIQA_HOME}/proj\""],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {"desc": "starts and lists the project", "wait": {"regex": "notes\\.txt", "timeout_ms": 8000}},
    {"desc": "the file does not exist yet", "assert": {"not_contains": "agent"}},
    {"desc": "a file created by another process shows up without any key", "wait": {"regex": "agent\\.go", "timeout_ms": 8000}},
    {"desc": "and it is marked as new with a +, not only with color", "assert": {"contains": "\\+\\s+\\S\\s+agent\\.go"}},
    {"desc": "the new name is green, an old one is not", "assert_color": {"region": {"x": 30, "y": 5, "w": 20, "h": 1}, "fg": "#a6e3a1", "mode": "any"}},
    {"assert_color": {"region": {"x": 30, "y": 7, "w": 20, "h": 1}, "fg": "#a6e3a1", "mode": "none"}},
    {"snapshot": {"name": "live-follow"}},
    {"keys": ["q"]},
    {"wait_exit": {"timeout_ms": 3000, "code": 0}}
  ]
}
