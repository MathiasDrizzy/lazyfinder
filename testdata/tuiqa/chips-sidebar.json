{
  "fixtures": "fixtures",
  "name": "chips-sidebar",
  "criterio": "order 07 revision 2, S1 and S3: the buttons of the tree header are the same chips as in the window (Mathias, 2026-10-14: herdr's ' g ' chip, three cells, the glyph in the middle, the actions side by side)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "--sidebar",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 44,
  "rows": 30,
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the pointer over the pane shows the buttons",
      "text": "\u001b[<35;10;8M"
    },
    {
      "wait": {
        "regex": "",
        "timeout_ms": 5000,
        "region": {
          "x": 38,
          "y": 3,
          "w": 1,
          "h": 1
        }
      }
    },
    {
      "text": "\u001b[<35;39;4M"
    },
    {
      "desc": "the new folder box of the tree, the same as in the window",
      "assert_color": {
        "region": {
          "x": 38,
          "y": 3,
          "w": 2,
          "h": 1
        },
        "bg": "#45475a",
        "mode": "all"
      }
    },
    {
      "desc": "the box starts at the half block before the glyph and ends after its space, so its two margins around the ink are equal in Ghostty (order 07, revision 3)",
      "wait": {
        "regex": "^▐[^ ] ?$",
        "timeout_ms": 3000,
        "region": {
          "x": 37,
          "y": 3,
          "w": 3,
          "h": 1
        }
      }
    },
    {
      "assert_color": {
        "region": {
          "x": 37,
          "y": 3,
          "w": 1,
          "h": 1
        },
        "bg": "#45475a",
        "mode": "none"
      }
    },
    {
      "assert_color": {
        "region": {
          "x": 40,
          "y": 3,
          "w": 1,
          "h": 1
        },
        "bg": "#45475a",
        "mode": "none"
      }
    }
  ],
  "fixtures_mtime": "2026-09-01T12:00:00Z"
}
