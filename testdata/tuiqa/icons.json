{
  "name": "lazyfinder-icons",
  "criterio": "order 2026-10-13-05 block B (Nerd Font icons per kind; icons setting nerd|ascii|off)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "a closed folder shows the folder glyph",
      "wait": {
        "regex": " +alpha",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "a text file shows the text glyph",
      "wait": {
        "regex": " +notes\\.txt",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "a Go file shows its own glyph",
      "wait": {
        "regex": " +main\\.go",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "+"
      ]
    },
    {
      "desc": "an expanded folder shows the open glyph",
      "wait": {
        "regex": " +alpha",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        ","
      ]
    },
    {
      "keys": [
        "j",
        "j",
        "j",
        "j",
        "j",
        "j",
        "right",
        "right"
      ]
    },
    {
      "desc": "Settings shows the Icons row and switched to ascii",
      "wait": {
        "regex": "‹ ascii ›",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "esc"
      ]
    },
    {
      "desc": "no Nerd Font glyph is left",
      "wait": {
        "regex": "",
        "timeout_ms": 5000,
        "absent": true
      }
    }
  ]
}
