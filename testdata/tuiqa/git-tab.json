{
  "name": "lazyfinder-git-tab",
  "criterio": "order 07 point O: the Git tab lists staged and unstaged changes, shows buttons under the pointer, stages, shows the diff, switches branch and stashes",
  "cmd": [
    "sh",
    "-c",
    "cd \"${TUIQA_HOME}/proj\" && export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null && g() { git -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false \"$@\"; } && g init -q -b trunk . && g add . && g commit -q -m init && g branch side && echo changed >> notes.txt && echo x > loose.txt; exec \"${LAZYFINDER_BIN}\" --sidebar \"${TUIQA_HOME}/proj\""
  ],
  "cols": 50,
  "rows": 24,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "loose\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the Git tab is one click away",
      "click": {
        "at": "",
        "in": {
          "x": 0,
          "y": 1,
          "w": 50,
          "h": 1
        }
      }
    },
    {
      "wait": {
        "regex": "Changes",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "down selects the first file",
      "keys": [
        "down"
      ]
    },
    {
      "desc": "the selected row wears its buttons: open, discard, stage",
      "wait": {
        "regex": "notes\\.txt.*↗ +↶ +\\+",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "a row nobody points at shows its letter instead",
      "wait": {
        "regex": "loose\\.txt.* U",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the pointer on the second row shows its buttons and a soft background",
      "text": "\u001b[<35;5;7M"
    },
    {
      "wait": {
        "regex": "loose\\.txt.*↗ +↶ +\\+",
        "timeout_ms": 5000
      }
    },
    {
      "assert_color": {
        "region": {
          "line_with": "loose\\.txt",
          "x": 1,
          "w": 10
        },
        "bg": "#353748",
        "mode": "any"
      }
    },
    {
      "desc": "s stages the selected file",
      "keys": [
        "s"
      ]
    },
    {
      "wait": {
        "regex": "Staged Changes",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "s again takes it out",
      "keys": [
        "s"
      ]
    },
    {
      "wait": {
        "regex": "Staged Changes",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "Enter shows what changed",
      "keys": [
        "enter"
      ]
    },
    {
      "wait": {
        "regex": "\\+changed",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "esc"
      ]
    },
    {
      "wait": {
        "regex": "\\+changed",
        "timeout_ms": 5000,
        "absent": true
      }
    },
    {
      "desc": "d asks before throwing work away",
      "keys": [
        "d"
      ]
    },
    {
      "wait": {
        "regex": "Discard the changes to notes\\.txt\\? \\(y/n\\)",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "n"
      ]
    },
    {
      "desc": "B opens the branches with a warning about the changes",
      "keys": [
        "B"
      ]
    },
    {
      "wait": {
        "regex": "Branches",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "2 uncommitted changes",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "side",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "s",
        "i"
      ]
    },
    {
      "keys": [
        "enter"
      ]
    },
    {
      "desc": "the branch changed and the footer says so",
      "wait": {
        "regex": "side\\s+↓",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "z"
      ]
    },
    {
      "desc": "stash empties the list",
      "wait": {
        "regex": "No changes",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
