{
  "name": "lazyfinder-keys",
  "criterio": "R-01 R-03 R-06 R-08",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "enter goes into the first folder (alpha)",
      "keys": [
        "enter"
      ]
    },
    {
      "wait": {
        "regex": "inner\\.txt"
      }
    },
    {
      "desc": "enter again goes into deep",
      "keys": [
        "enter"
      ]
    },
    {
      "wait": {
        "regex": "x\\.txt"
      }
    },
    {
      "desc": "backspace goes up",
      "keys": [
        "backspace"
      ]
    },
    {
      "wait": {
        "regex": "inner\\.txt"
      }
    },
    {
      "desc": "h and l walk up and down",
      "keys": [
        "h"
      ]
    },
    {
      "wait": {
        "regex": "notes\\.txt"
      }
    },
    {
      "keys": [
        "l"
      ]
    },
    {
      "wait": {
        "regex": "inner\\.txt"
      }
    },
    {
      "desc": "alt+left is back, alt+right is forward",
      "keys": [
        "alt+left"
      ]
    },
    {
      "wait": {
        "regex": "notes\\.txt"
      }
    },
    {
      "keys": [
        "alt+right"
      ]
    },
    {
      "wait": {
        "regex": "inner\\.txt"
      }
    },
    {
      "keys": [
        "left"
      ]
    },
    {
      "wait": {
        "regex": "notes\\.txt"
      }
    },
    {
      "desc": ". reveals dotfiles, . hides them again",
      "keys": [
        "."
      ]
    },
    {
      "wait": {
        "regex": "\\.secret"
      }
    },
    {
      "keys": [
        "."
      ]
    },
    {
      "wait": {
        "regex": "\\.secret",
        "absent": true
      }
    },
    {
      "desc": "s cycles the sort column, S reverses",
      "keys": [
        "s"
      ]
    },
    {
      "wait": {
        "regex": "Date Modified ▲"
      }
    },
    {
      "keys": [
        "S"
      ]
    },
    {
      "wait": {
        "regex": "Date Modified ▼"
      }
    },
    {
      "desc": "Tab moves to the sidebar and back",
      "keys": [
        "tab",
        "down",
        "tab"
      ]
    },
    {
      "wait": {
        "regex": "Name",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
