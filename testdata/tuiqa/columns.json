{
  "name": "lazyfinder-columns",
  "criterio": "order 2026-10-13-05 block G (right click on the header chooses and moves columns, date format and density in Settings)",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 140,
  "rows": 40,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the Kind column is not cut",
      "wait": {
        "regex": "Excel Spreadsheet",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "right click on a header opens the columns menu",
      "click": {
        "at": "Size",
        "in": {
          "x": 23,
          "y": 2,
          "w": 110,
          "h": 1
        },
        "button": "right"
      }
    },
    {
      "wait": {
        "regex": "✓ Size",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Move left",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "choose Extension",
      "click": {
        "at": "Extension",
        "in": {
          "x": 0,
          "y": 3,
          "w": 140,
          "h": 30
        }
      }
    },
    {
      "desc": "the new column shows the extension of each file",
      "wait": {
        "regex": "(?m)xlsx\\s",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "rows are two lines apart by default (wide density)",
      "wait": {
        "regex": "alpha[^\\n]*\\n[^\\n]*\\n[^\\n]*beta",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Settings has the new rows",
      "keys": [
        ","
      ]
    },
    {
      "wait": {
        "regex": "Date format",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Row density",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "move to Row density and cycle it back to compact",
      "keys": [
        "down",
        "down",
        "down",
        "down",
        "down",
        "down",
        "down",
        "down",
        "down",
        "right",
        "esc"
      ]
    },
    {
      "desc": "now the rows are one line apart",
      "wait": {
        "regex": "alpha[^\\n]*\\n[^\\n]*beta",
        "timeout_ms": 5000
      }
    }
  ]
}
