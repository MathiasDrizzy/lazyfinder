{
  "name": "lazyfinder-defaults-120",
  "criterio": "order 2026-10-13-05 revision 2, amended on 2026-10-14 (the date created is a default column): at 120 columns in Spanish the five default columns are shown with readable data, a long title is cut with … instead of dropping a column, dates are never cut; and every selected row, in the list, the sidebar and the column view, is the blue-gray selection",
  "cmd": [
    "${LAZYFINDER_BIN}",
    "${TUIQA_HOME}/proj"
  ],
  "cols": 120,
  "rows": 30,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "env": {
    "LC_ALL": "es_ES.UTF-8",
    "LANG": "es_ES.UTF-8"
  },
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "the five default columns are on the header, long titles may be cut",
      "wait": {
        "regex": "Nombre.*Fecha de modifi.*Fecha de creaci.*Tamaño.*Clase",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "both dates of a row are whole",
      "wait": {
        "regex": "\\d\\d/\\d\\d/\\d{4} \\d\\d:\\d\\d\\s+\\d\\d/\\d\\d/\\d{4} \\d\\d:\\d\\d",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "the kind is readable even when it is cut",
      "wait": {
        "regex": "Hoja de cálculo",
        "timeout_ms": 5000
      }
    },
    {
      "wait": {
        "regex": "Código fuente",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "no date is cut",
      "wait": {
        "regex": "\\d\\d/\\d\\d/[\\d ]{0,9}…",
        "timeout_ms": 3000,
        "absent": true
      }
    },
    {
      "desc": "the selected row of the list is blue-gray",
      "assert_color": {
        "region": {
          "line_with": "▸ >\\s+\\S\\s+alpha"
        },
        "bg": "#45475a",
        "mode": "any"
      }
    },
    {
      "assert_color": {
        "region": {
          "line_with": "▸ >\\s+\\S\\s+alpha"
        },
        "bg": "#fab387",
        "mode": "none"
      }
    },
    {
      "desc": "in the column view too",
      "keys": [
        "M"
      ]
    },
    {
      "assert_color": {
        "region": {
          "line_with": "▸ >\\s+\\S\\s+alpha",
          "x": 40,
          "w": 20
        },
        "bg": "#fab387",
        "mode": "none"
      }
    },
    {
      "assert_color": {
        "region": {
          "line_with": "▸ >\\s+\\S\\s+alpha",
          "x": 40,
          "w": 20
        },
        "bg": "#45475a",
        "mode": "any"
      }
    },
    {
      "desc": "and in the sidebar",
      "keys": [
        "M",
        "tab"
      ]
    },
    {
      "assert_color": {
        "region": {
          "line_with": "│▸ \\S \\w",
          "x": 1,
          "w": 20
        },
        "bg": "#45475a",
        "mode": "any"
      }
    },
    {
      "assert_color": {
        "region": {
          "line_with": "│▸ \\S \\w",
          "x": 1,
          "w": 20
        },
        "bg": "#fab387",
        "mode": "none"
      }
    }
  ]
}
