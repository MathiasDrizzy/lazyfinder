{
  "name": "lazyfinder-sidebar-boxes-grow",
  "criterio": "order 2026-10-13-06 point 1, Mathias's precision: Favorites stretches as folders are added (Locations gives space up, keeping a minimum) and shrinks back when they are removed",
  "cmd": [
    "sh",
    "-c",
    "mkdir -p \"${TUIQA_HOME}/.config/lazyfinder\" && printf '%s' '{\"version\":1,\"sidebar\":{\"favorites\":[{\"name\":\"fav00\",\"path\":\"~/proj\"},{\"name\":\"fav01\",\"path\":\"~/proj\"},{\"name\":\"fav02\",\"path\":\"~/proj\"},{\"name\":\"fav03\",\"path\":\"~/proj\"},{\"name\":\"fav04\",\"path\":\"~/proj\"},{\"name\":\"fav05\",\"path\":\"~/proj\"},{\"name\":\"fav06\",\"path\":\"~/proj\"},{\"name\":\"fav07\",\"path\":\"~/proj\"},{\"name\":\"fav08\",\"path\":\"~/proj\"},{\"name\":\"fav09\",\"path\":\"~/proj\"},{\"name\":\"fav10\",\"path\":\"~/proj\"},{\"name\":\"fav11\",\"path\":\"~/proj\"}],\"locations\":[{\"name\":\"Disk\",\"path\":\"/\"}]}}' > \"${TUIQA_HOME}/.config/lazyfinder/config.json\" && exec \"${LAZYFINDER_BIN}\" \"${TUIQA_HOME}/proj\""
  ],
  "cols": 120,
  "rows": 24,
  "fixtures": "fixtures",
  "fixtures_mtime": "2026-09-01T12:00:00Z",
  "steps": [
    {
      "wait": {
        "regex": "notes\\.txt",
        "timeout_ms": 8000
      }
    },
    {
      "desc": "12 favorites: Favorites is taller than half, Locations opens on the 16th line",
      "wait": {
        "regex": "\\A(?:[^\\n]*\\n){16}╭─ Locations",
        "timeout_ms": 5000
      }
    },
    {
      "desc": "Locations is still visible with its item",
      "wait": {
        "regex": "Disk",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "tab",
        "down"
      ]
    },
    {
      "wait": {
        "regex": "▸ [^\\n]*fav00"
      }
    },
    {
      "desc": "remove ten favorites with d",
      "keys": [
        "d",
        "d",
        "d",
        "d",
        "d",
        "d",
        "d",
        "d",
        "d",
        "d"
      ]
    },
    {
      "desc": "back to the default favorites: Locations moves up again",
      "wait": {
        "regex": "\\A(?:[^\\n]*\\n){6}╭─ Locations",
        "timeout_ms": 5000
      }
    },
    {
      "keys": [
        "q"
      ]
    },
    {
      "wait_exit": {
        "timeout_ms": 3000,
        "code": 0
      }
    }
  ]
}
