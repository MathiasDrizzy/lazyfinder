# Stay in the folder on exit: with the shell function, quitting leaves the shell where lazyfinder was.
Output assets/readme/feature-cd-on-exit.gif
Set Width 1200
Set Height 700
Source assets/readme/tapes/lib/common.tape
Type 'eval "$(lazyfinder --shell-init bash)"' Enter
Type "clear" Enter
Show
Sleep 500ms

Type "pwd" Enter
Sleep 1s
Type "lazyfinder" Enter
Wait+Screen@20s /Favorites/
Sleep 1s
Down
Sleep 300ms
Down
Sleep 300ms
Down
Sleep 300ms
Down
Sleep 500ms
Enter
Sleep 700ms
Enter
Sleep 1.2s
Type "q"
Sleep 800ms
Type "pwd" Enter
Sleep 2.5s
