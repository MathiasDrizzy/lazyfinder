{
 "output": "feature-git.gif",
 "windows": [
  {
   "name": "herdr",
   "cols": 118,
   "rows": 32,
   "cwd": "Projects/website",
   "argv": [
    "herdr"
   ],
   "setup": [
    {
     "wait": "WEBSITE"
    },
    {
     "wait": "\\$ "
    },
    {
     "sleep": 1
    },
    {
     "raw": "\u001b[<0;91;3M\u001b[<0;91;3m"
    },
    {
     "wait": "Staged"
    },
    {
     "keys": [
      "ctrl+a",
      "\u001b[104u"
     ],
     "gap": 0.3
    },
    {
     "sleep": 1
    }
   ],
   "steps": [
    {
     "sleep": 2
    },
    {
     "type": "git add style.css"
    },
    {
     "sleep": 0.4
    },
    {
     "keys": [
      "enter"
     ],
     "gap": 2.2
    },
    {
     "keys": [
      "ctrl+a",
      "\u001b[108u"
     ],
     "gap": 0.3
    },
    {
     "sleep": 1
    },
    {
     "keys": [
      "down"
     ],
     "gap": 0.5
    },
    {
     "keys": [
      "down"
     ],
     "gap": 0.8
    },
    {
     "keys": [
      "enter"
     ],
     "gap": 3.5
    },
    {
     "keys": [
      "esc"
     ],
     "gap": 1
    },
    {
     "keys": [
      "ctrl+a",
      "\u001b[104u"
     ],
     "gap": 0.3
    },
    {
     "sleep": 0.6
    },
    {
     "type": "git commit -m \"Add the footer color\""
    },
    {
     "sleep": 0.4
    },
    {
     "keys": [
      "enter"
     ],
     "gap": 3
    },
    {
     "post": "end"
    }
   ],
   "title": "website"
  }
 ],
 "config": {
  "herdr": {
   "dock": "right",
   "auto_open": true,
   "width": 38
  }
 }
}
